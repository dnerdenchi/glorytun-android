+static uint64_t
+path_rate_burst_bytes(const path_entry_t *p)
+{
+    uint64_t burst = p->rate_limit_bytes_per_sec / 10;
+    return burst < 4096 ? 4096 : burst;
+}
+
+static int
+path_rate_allow(mqvpn_client_t *c, path_entry_t *p, size_t size)
+{
+    if (!p || p->rate_limit_bytes_per_sec == 0) return 1;
+
+    uint64_t now = client_now_us(c);
+    uint64_t burst = path_rate_burst_bytes(p);
+    if ((uint64_t)size > burst) burst = (uint64_t)size;
+    if (p->rate_limit_last_refill_us == 0 || now < p->rate_limit_last_refill_us) {
+        p->rate_limit_tokens = burst;
+        p->rate_limit_last_refill_us = now;
+    } else if (now > p->rate_limit_last_refill_us) {
+        uint64_t elapsed = now - p->rate_limit_last_refill_us;
+        uint64_t added;
+        if (elapsed > UINT64_MAX / p->rate_limit_bytes_per_sec) {
+            added = burst;
+        } else {
+            added = elapsed * p->rate_limit_bytes_per_sec / 1000000ULL;
+        }
+        p->rate_limit_tokens =
+            added >= burst - p->rate_limit_tokens ? burst : p->rate_limit_tokens + added;
+        p->rate_limit_last_refill_us = now;
+    }
+
+    if (p->rate_limit_tokens < size) return 0;
+    p->rate_limit_tokens -= size;
+    return 1;
+}
