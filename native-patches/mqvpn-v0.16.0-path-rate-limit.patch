+int
+mqvpn_client_set_path_rate_limit(mqvpn_client_t *c, mqvpn_path_handle_t path,
+                                 uint64_t bytes_per_sec)
+{
+    if (!c) return MQVPN_ERR_INVALID_ARG;
+    ASSERT_TICK_THREAD(c);
+    path_entry_t *p = find_path_by_handle(c, path);
+    if (!p) return MQVPN_ERR_INVALID_ARG;
+    p->rate_limit_bytes_per_sec = bytes_per_sec;
+    p->rate_limit_tokens = bytes_per_sec == 0 ? 0 : path_rate_burst_bytes(p);
+    p->rate_limit_last_refill_us = client_now_us(c);
+    return MQVPN_OK;
+}
